[Desktop Entry]
Type=Application
Name=Pictures
Exec=makos-app pictures %U
Icon=makos-photos
Terminal=false
OnlyShowIn=MakkOS;MakOS;
Categories=Graphics;Photography;Viewer;
StartupNotify=true
StartupWMClass=org.makos.Apps.pictures
MimeType=image/jpeg;image/png;image/webp;
Keywords=photos;albums;slideshow;
