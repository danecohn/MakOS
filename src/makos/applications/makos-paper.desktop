[Desktop Entry]
Type=Application
Name=Paper
Exec=makos-app paper %U
Icon=makos-file-document
Terminal=false
OnlyShowIn=MakOS;
Categories=Office;WordProcessor;
StartupNotify=true
StartupWMClass=makos-paper
MimeType=application/vnd.oasis.opendocument.text;application/msword;application/vnd.openxmlformats-officedocument.wordprocessingml.document;
Keywords=word;documents;writing;
