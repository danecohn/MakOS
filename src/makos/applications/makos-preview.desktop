[Desktop Entry]
Type=Application
Name=Preview
Exec=makos-app preview %U
Icon=makos-preview
Terminal=false
OnlyShowIn=MakkOS;MakOS;
Categories=Graphics;Viewer;
StartupNotify=true
StartupWMClass=org.makos.Apps.preview
MimeType=application/pdf;image/png;image/jpeg;image/gif;image/webp;image/bmp;image/tiff;
Keywords=pdf;image;viewer;
