[Desktop Entry]
Type=Application
Name=Tunes
Exec=makos-app tunes %U
Icon=makos-music
Terminal=false
OnlyShowIn=MakkOS;MakOS;
Categories=AudioVideo;Audio;Player;
StartupNotify=true
StartupWMClass=org.makos.Apps.tunes
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/x-wav;audio/mp4;audio/aac;
Keywords=music;songs;player;
