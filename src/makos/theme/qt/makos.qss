/* VigilOS for Qt widgets (applied through qt6ct on top of Fusion). VigilTech design system, GPL-3.0-only.
 * @DIR@ is replaced by the installer with this directory's absolute path. Every text/background pair is 4.5:1 or better. */
QWidget { color: #17101a; }
QMainWindow, QDialog, QMessageBox { background: #f6f1f4; }
QPushButton, QToolButton, QComboBox, QAbstractSpinBox { min-height: 22px; }
QPushButton { padding: 4px 14px; border-radius: 8px; border: 1px solid #857380; color: #17101a; background: #fffbfd; }
QPushButton:hover { border-color: #5d4e5a; background: #ebe2e8; }
QPushButton:pressed, QPushButton:checked { border-color: #5d4e5a; background: #ddd1d9; }
QPushButton:default { color: #ffffff; border-color: #a8003a; background: #d6004a; }
QPushButton:default:hover { background: #b80040; }
QPushButton:default:pressed { background: #99003a; }
QPushButton:disabled, QToolButton:disabled { color: #5d4e5a; border-color: #d9ccd4; background: #ebe2e8; }
QPushButton:focus { outline: none; border: 2px solid #d6004a; }
QToolButton { border: 1px solid transparent; border-radius: 8px; padding: 3px 6px; background: transparent; color: #17101a; }
QToolButton:hover { background: #ebe2e8; }
QToolButton:pressed, QToolButton:checked { background: #ddd1d9; }
QToolBar { background: #faf5f8; border-bottom: 1px solid #d9ccd4; padding: 3px; spacing: 4px; }
QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background: #fffbfd; border: 1px solid #857380; border-radius: 8px; padding: 3px 8px; selection-background-color: #d6004a; selection-color: #ffffff; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus, QComboBox:focus { border: 2px solid #d6004a; }
QLineEdit:disabled, QAbstractSpinBox:disabled { background: #ebe2e8; color: #5d4e5a; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { width: 18px; border-left: 1px solid #d9ccd4; background: #faf5f8; }
QAbstractSpinBox::up-arrow { image: url(@DIR@/arrow-up.svg); width: 9px; height: 9px; }
QAbstractSpinBox::down-arrow { image: url(@DIR@/arrow-down.svg); width: 9px; height: 9px; }
QComboBox { padding: 3px 8px; border-radius: 8px; border: 1px solid #857380; background: #fffbfd; color: #17101a; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox::down-arrow { image: url(@DIR@/arrow-down.svg); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background: #fffbfd; border: 1px solid #d9ccd4; selection-background-color: #d6004a; selection-color: #ffffff; outline: none; }
QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; border: 1px solid #857380; background: #fffbfd; }
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked, QCheckBox::indicator:indeterminate { border-color: #a8003a; background: #d6004a; }
QCheckBox::indicator:checked { image: url(@DIR@/check.svg); }
QCheckBox::indicator:indeterminate { image: url(@DIR@/check-mixed.svg); }
QRadioButton::indicator:checked { image: url(@DIR@/radio-dot.svg); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { border-color: #d9ccd4; background: #ebe2e8; }
QGroupBox { border: 1px solid #d9ccd4; border-radius: 12px; margin-top: 10px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; font-weight: bold; }
QProgressBar { border: 1px solid #d9ccd4; border-radius: 6px; height: 10px; text-align: center; color: #17101a; background: #ddd1d9; }
QProgressBar::chunk { border-radius: 5px; background: #d6004a; }
QSlider::groove:horizontal { height: 6px; border-radius: 3px; background: #ddd1d9; }
QSlider::sub-page:horizontal { border-radius: 3px; background: #d6004a; }
QSlider::handle:horizontal { width: 16px; height: 16px; margin: -6px 0; border-radius: 9px; border: 1px solid #857380; background: #ffffff; }
QSlider::handle:horizontal:hover { border-color: #d6004a; }
QSlider::groove:vertical { width: 6px; border-radius: 3px; background: #ddd1d9; }
QSlider::handle:vertical { width: 16px; height: 16px; margin: 0 -6px; border-radius: 9px; border: 1px solid #857380; background: #ffffff; }
QScrollBar:vertical { background: #faf5f8; width: 13px; margin: 0; }
QScrollBar:horizontal { background: #faf5f8; height: 13px; margin: 0; }
QScrollBar::handle:vertical { min-height: 30px; margin: 2px; border-radius: 5px; background: #857380; }
QScrollBar::handle:horizontal { min-width: 30px; margin: 2px; border-radius: 5px; background: #857380; }
QScrollBar::handle:hover { background: #5d4e5a; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QTabWidget::pane { border: 1px solid #d9ccd4; background: #f6f1f4; top: -1px; }
QTabBar::tab { padding: 5px 16px; margin: 0 1px; border: 1px solid transparent; border-bottom: none; border-top-left-radius: 8px; border-top-right-radius: 8px; color: #5d4e5a; }
QTabBar::tab:hover { color: #17101a; background: #ebe2e8; }
QTabBar::tab:selected { color: #17101a; background: #f6f1f4; border-color: #d9ccd4; }
QMenuBar { background: #faf5f8; border-bottom: 1px solid #d9ccd4; color: #17101a; }
QMenuBar::item { padding: 3px 10px; background: transparent; }
QMenuBar::item:selected { background: #d6004a; color: #ffffff; }
QMenu { background: #fffbfd; border: 1px solid #d9ccd4; padding: 4px 0; color: #17101a; }
QMenu::item { padding: 4px 26px 4px 20px; }
QMenu::item:selected { background: #d6004a; color: #ffffff; }
QMenu::item:disabled { color: #5d4e5a; }
QMenu::separator { height: 1px; background: #d9ccd4; margin: 4px 0; }
QHeaderView::section { padding: 4px 8px; border: none; border-right: 1px solid #d9ccd4; border-bottom: 1px solid #d9ccd4; font-weight: bold; background: #faf5f8; color: #17101a; }
QListView, QTreeView, QTableView { background: #fffbfd; alternate-background-color: #faf4f7; border: 1px solid #d9ccd4; outline: none; color: #17101a; }
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected { color: #ffffff; background: #d6004a; }
QStatusBar { background: #faf5f8; border-top: 1px solid #d9ccd4; color: #5d4e5a; }
QToolTip { background: #1e1422; color: #f7eef2; border: 1px solid #3a2a3d; padding: 3px 6px; }
QSplitter::handle { background: #d9ccd4; }
