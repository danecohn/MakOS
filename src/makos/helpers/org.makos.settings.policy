<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!-- Adapted for MakkOS from Amerika OS org.amerika.settings.policy (GPL-3.0-only, VigilTech). -->
<policyconfig>
  <vendor>MakkOS</vendor>
  <action id="org.makos.settings.manage">
    <description>Change protected system settings</description>
    <message>Authentication is required to change the firewall, lid, battery or software update settings</message>
    <icon_name>makos-settings</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/makos/makos-settings-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
