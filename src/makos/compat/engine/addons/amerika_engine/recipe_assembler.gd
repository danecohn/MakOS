extends RefCounted
## Recipe assembler: deterministically turns res://amerika_recipe.json into scenes, scripts-by-reference, input map,
## autoloads and project settings. No editor APIs are used, so it also runs from `godot --headless -s` (CI, CLI, tests).
##
## Generated files: entities/<key>.tscn, levels/<name>.tscn (or scenes/main.tscn), ui/hud.tscn, amerika_game.json,
## export_presets.cfg (when the recipe lists presets) and the project settings. A manifest (.amerika/assembled.json)
## remembers what was generated, so hand-edited files are kept unless overwrite=true.

const Tscn := preload("res://addons/amerika_engine/tscn_writer.gd")
const RecipeScript := preload("res://addons/amerika_engine/recipe.gd")
const ExportPresets := preload("res://addons/amerika_engine/export_presets.gd")
const InputMapper := preload("res://addons/amerika_engine/input_map.gd")

const MANIFEST := "res://.amerika/assembled.json"
const HEADER := "; Generated by Engine from amerika_recipe.json. Re-assembling overwrites this file; extend behaviour with components or your own scripts.\n"
const GAME_SCRIPT := "res://addons/amerika_engine/runtime/game.gd"
const DEBUG_SCRIPT := "res://addons/amerika_engine/runtime/debug_agent.gd"
const COMP_DIR := "res://addons/amerika_engine/components/"

const DEFAULT_THEME := {
	"accent": "#ff3d6e", "text": "#fff0cf", "panel": "#0e0810", "sky": "#1a0f2e", "ground": "#24123d",
	"wall": "#5b3a8c", "player": "#ffb02e", "enemy": "#ff3d6e", "item": "#ffe14d",
}
const ROLE_COLOR := {"player": "player", "enemy": "enemy", "item": "item", "hazard": "enemy", "goal": "accent", "npc": "text", "block": "wall", "prop": "wall", "spawner": "accent"}
const SIZE_2D := {
	"player": [22, 30], "enemy": [24, 22], "item": [14, 14], "hazard": [28, 14], "goal": [28, 36],
	"npc": [22, 32], "block": [32, 32], "prop": [20, 20], "spawner": [16, 16],
}
const SIZE_3D := {
	"player": [0.8, 1.8, 0.8], "enemy": [0.9, 1.2, 0.9], "item": [0.5, 0.5, 0.5], "hazard": [1.0, 0.4, 1.0],
	"goal": [1.4, 2.2, 1.4], "npc": [0.8, 1.8, 0.8], "block": [2.0, 3.0, 2.0], "prop": [1.0, 1.0, 1.0], "spawner": [0.5, 0.5, 0.5],
}
const SHAPE_DEFAULT := {"player": "box", "enemy": "box", "item": "circle", "hazard": "box", "goal": "box", "npc": "box", "block": "box", "prop": "box", "spawner": "circle"}
const BOTTOM_ALIGNED := ["player", "enemy", "npc", "goal", "hazard"]
const DEFAULT_INPUT_2D := {
	"move_left": ["A", "Left"], "move_right": ["D", "Right"], "move_up": ["W", "Up"], "move_down": ["S", "Down"],
	"jump": ["Space", "W", "Up"], "shoot": ["J", "X", "Mouse:Left"], "interact": ["E"], "restart": ["R"],
}
const DEFAULT_INPUT_3D := {
	"move_left": ["A"], "move_right": ["D"], "move_up": ["W", "Up"], "move_down": ["S", "Down"],
	"look_left": ["Q", "Left"], "look_right": ["E", "Right"],
	"jump": ["Space"], "shoot": ["F", "Mouse:Left"], "interact": ["E"], "restart": ["R"],
}
const FLOOR_SHADER := """shader_type spatial;
uniform vec4 base : source_color = vec4(0.05, 0.03, 0.1, 1.0);
uniform vec4 line : source_color = vec4(1.0, 0.24, 0.43, 1.0);
uniform float cell = 2.0;
varying vec3 wp;
void vertex() { wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; }
void fragment() {
	vec2 uv = wp.xz / cell;
	vec2 g = abs(fract(uv - 0.5) - 0.5) / fwidth(uv);
	float l = 1.0 - min(min(g.x, g.y), 1.0);
	ALBEDO = mix(base.rgb, line.rgb, l);
	EMISSION = line.rgb * l * 0.9;
	ROUGHNESS = 0.9;
}
"""

var recipe: Dictionary = {}
var recipes: RefCounted
var theme: Dictionary = {}
var genre: String = ""
var is_3d: bool = false
var entities: Dictionary = {}
var report: Dictionary = {}
var _written: Dictionary = {} ## res path -> content
var _manifest: Dictionary = {}
var _overwrite: bool = false
var _before_write: Callable = Callable()
var _comp_defs: Dictionary = {}


## options: overwrite (bool), before_write (Callable(path) called before an existing file is replaced), dry_run (bool)
func assemble(recipe_in: Dictionary, options: Dictionary = {}) -> Dictionary:
	report = {"ok": false, "files": [], "skipped": [], "warnings": [], "notes": [], "errors": [], "main_scene": ""}
	recipes = RecipeScript.new()
	var issues: Array = recipes.validate(recipe_in, "res://")
	for i in issues:
		if i["severity"] == "error":
			report["errors"].append(recipes.format_issue(i))
		else:
			report["warnings"].append(recipes.format_issue(i))
	if not report["errors"].is_empty():
		return report
	recipe = recipe_in
	_comp_defs = recipes.components()
	_overwrite = bool(options.get("overwrite", false))
	_before_write = options.get("before_write", Callable())
	genre = recipe["genre"]
	is_3d = RecipeScript.DIMS.get(genre, "") == "3d"
	theme = DEFAULT_THEME.duplicate()
	theme.merge(recipe.get("theme", {}), true)
	entities = recipe.get("entities", {})
	_manifest = _load_manifest()
	_written = {}

	var levels_cfg: Array = []
	if RecipeScript.GAMEPLAY.has(genre):
		for level in recipe["levels"]:
			var path := "res://levels/%s.tscn" % level["name"]
			_emit(path, _level_scene(level))
			levels_cfg.append({"name": level["name"], "scene": path})
		for key in _used_entities():
			if _is_plain_block(key):
				continue
			_emit("res://entities/%s.tscn" % key, _entity_scene(key))
		report["main_scene"] = levels_cfg[0]["scene"]
	else:
		var main_path := "res://scenes/main.tscn"
		_emit(main_path, _simple_scene())
		levels_cfg.append({"name": "main", "scene": main_path})
		report["main_scene"] = main_path
	_emit("res://ui/hud.tscn", _hud_scene())
	_emit("res://amerika_game.json", JSON.stringify(_game_config(levels_cfg), "\t", true) + "\n", false)
	if recipe.has("export_presets"):
		_emit("res://export_presets.cfg", ExportPresets.new().render(recipe["export_presets"]), false)
	if not bool(options.get("dry_run", false)):
		_flush()
		var err := _apply_project_settings()
		if err != OK:
			report["errors"].append("E_PROJECT_SETTINGS could not save project.godot (%s)" % error_string(err))
	report["ok"] = report["errors"].is_empty()
	return report


# ------------------------------------------------------------------ file output

func _emit(path: String, content: String, header: bool = true) -> void:
	_written[path] = (HEADER + content) if header and path.ends_with(".tscn") else content


func _load_manifest() -> Dictionary:
	if FileAccess.file_exists(MANIFEST):
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(MANIFEST))
		if parsed is Dictionary:
			return parsed
	return {}


func _flush() -> void:
	var paths := _written.keys()
	paths.sort()
	var new_manifest := {}
	for path in paths:
		var content: String = _written[path]
		var sha := content.sha1_text()
		if FileAccess.file_exists(path):
			var existing := FileAccess.get_file_as_string(path)
			if existing == content:
				new_manifest[path] = sha
				report["files"].append(path)
				continue
			var known: String = str(_manifest.get(path, ""))
			var edited: bool = known == "" or existing.sha1_text() != known
			if edited and not _overwrite:
				report["skipped"].append(path)
				report["warnings"].append("kept %s (not generated by the assembler or edited since; pass overwrite=true to replace it)" % path)
				if known != "":
					new_manifest[path] = known
				continue
		if _before_write.is_valid():
			_before_write.call(path)
		DirAccess.make_dir_recursive_absolute(path.get_base_dir())
		var f := FileAccess.open(path, FileAccess.WRITE)
		if f == null:
			report["errors"].append("E_WRITE could not write %s (%s)" % [path, error_string(FileAccess.get_open_error())])
			continue
		f.store_string(content)
		f.close()
		new_manifest[path] = sha
		report["files"].append(path)
	DirAccess.make_dir_recursive_absolute("res://.amerika")
	if _before_write.is_valid():
		_before_write.call(MANIFEST)
	var mf := FileAccess.open(MANIFEST, FileAccess.WRITE)
	if mf != null:
		mf.store_string(JSON.stringify(new_manifest, "\t", true) + "\n")


# ------------------------------------------------------------------ project settings

func input_actions() -> Dictionary:
	var actions: Dictionary = (DEFAULT_INPUT_3D if is_3d else DEFAULT_INPUT_2D).duplicate(true)
	if genre == "visual_novel" or genre == "puzzle":
		actions = {"restart": ["R"]}
	for a in recipe.get("input", {}).keys():
		actions[a] = recipe["input"][a]
	return actions


func _apply_project_settings() -> int:
	if _before_write.is_valid():
		_before_write.call("res://project.godot")
	ProjectSettings.set_setting("application/config/name", recipe["name"])
	ProjectSettings.set_setting("application/run/main_scene", report["main_scene"])
	if recipe.has("description"):
		ProjectSettings.set_setting("application/config/description", recipe["description"])
	var v := Engine.get_version_info()
	ProjectSettings.set_setting("application/config/features", PackedStringArray(["%d.%d" % [v["major"], v["minor"]]]))
	if FileAccess.file_exists("res://icon.svg"):
		ProjectSettings.set_setting("application/config/icon", "res://icon.svg")
	var win: Dictionary = recipe.get("window", {})
	ProjectSettings.set_setting("display/window/size/viewport_width", int(win.get("width", 1280 if is_3d else 1152)))
	ProjectSettings.set_setting("display/window/size/viewport_height", int(win.get("height", 720 if is_3d else 648)))
	if win.get("fullscreen", false):
		ProjectSettings.set_setting("display/window/size/mode", 3)
	ProjectSettings.set_setting("display/window/stretch/mode", str(win.get("stretch", "disabled" if is_3d else "canvas_items")))
	ProjectSettings.set_setting("rendering/environment/defaults/default_clear_color", Color(theme["panel"]))
	if not is_3d:
		ProjectSettings.set_setting("rendering/renderer/rendering_method", "gl_compatibility")
		ProjectSettings.set_setting("rendering/renderer/rendering_method.mobile", "gl_compatibility")
	var mapped: Dictionary = InputMapper.new().apply(input_actions(), false)
	for w_ in mapped["warnings"]:
		report["warnings"].append("E_INPUT_KEY " + str(w_))
	ProjectSettings.set_setting("autoload/AmerikaGame", "*" + GAME_SCRIPT)
	ProjectSettings.set_setting("autoload/AmerikaDebug", "*" + DEBUG_SCRIPT)
	for n in recipe.get("autoloads", {}).keys():
		ProjectSettings.set_setting("autoload/" + n, "*" + str(recipe["autoloads"][n]))
	if FileAccess.file_exists("res://addons/amerika_engine/plugin.cfg"):
		ProjectSettings.set_setting("editor_plugins/enabled", PackedStringArray(["res://addons/amerika_engine/plugin.cfg"]))
	return ProjectSettings.save()


# ------------------------------------------------------------------ game config

func _game_config(levels_cfg: Array) -> Dictionary:
	var cfg := {
		"name": recipe["name"], "genre": genre, "levels": levels_cfg,
		"theme": {"accent": theme["accent"], "text": theme["text"], "panel": theme["panel"]},
		"ui": {"title": recipe.get("ui", {}).get("title", recipe["name"]),
			"hud": recipe.get("ui", {}).get("hud", [] if genre == "visual_novel" or genre == "puzzle" else ["score", "health", "level", "message"]),
			"win_text": recipe.get("ui", {}).get("win_text", "You win!"),
			"lose_text": recipe.get("ui", {}).get("lose_text", "Game over")},
		"audio": recipe.get("audio", {}),
		"rules": _rules(),
	}
	if recipe.has("story"):
		cfg["story"] = recipe["story"]
	if genre == "puzzle":
		cfg["puzzle"] = recipe.get("puzzle", {})
	return cfg


func _rules() -> Dictionary:
	var rules: Dictionary = recipe.get("rules", {}).duplicate(true)
	if RecipeScript.GAMEPLAY.has(genre):
		if not rules.has("win"):
			var roles := {}
			for k in _used_entities():
				roles[entities[k]["role"] if entities.has(k) else "block"] = true
			if roles.has("goal"):
				rules["win"] = {"type": "reach_goal"}
			elif roles.has("item"):
				rules["win"] = {"type": "collect_all"}
			elif roles.has("enemy"):
				rules["win"] = {"type": "kill_all"}
			else:
				rules["win"] = {"type": "none"}
		if not rules.has("lose"):
			rules["lose"] = {"type": "health_zero"}
	return rules


# ------------------------------------------------------------------ entities

func _used_entities() -> Array:
	var used := {}
	for level in recipe.get("levels", []):
		var legend: Dictionary = level.get("legend", {})
		for row in level.get("rows", []):
			for ch in String(row):
				if legend.has(ch):
					used[legend[ch]] = true
		for o in level.get("objects", []):
			used[o["entity"]] = true
	# spawners reference other entities by key
	var changed := true
	while changed:
		changed = false
		for k in used.keys():
			if not entities.has(k):
				continue
			for c in entities[k].get("components", []):
				if c["type"] == "spawner" and c.has("scene") and entities.has(c["scene"]) and not used.has(c["scene"]):
					used[c["scene"]] = true
					changed = true
	var keys := []
	for k in used.keys():
		if k != "block" or entities.has("block"):
			keys.append(k)
	keys.sort()
	return keys


func _color(spec: Variant, role: String) -> Color:
	if spec is String:
		return Color(spec)
	return Color(theme[ROLE_COLOR.get(role, "wall")])


func _size(ent: Dictionary) -> Array:
	if ent.has("size"):
		var s: Array = ent["size"].duplicate()
		if is_3d and s.size() == 2:
			s.append(s[0])
		return s
	return (SIZE_3D if is_3d else SIZE_2D)[ent["role"]].duplicate()


func _shape(ent: Dictionary) -> String:
	var s: String = ent.get("shape", SHAPE_DEFAULT[ent["role"]])
	if is_3d and s == "circle":
		return "sphere"
	if not is_3d and s == "sphere":
		return "circle"
	return s


func _pascal(text: String) -> String:
	var out := ""
	for part in text.split("_", false):
		out += part.capitalize().replace(" ", "")
	return out


## The component list actually built into an entity scene (recipe components + role defaults).
func effective_components(key: String) -> Array:
	var ent: Dictionary = entities.get(key, {"role": "block"})
	var comps: Array = []
	for c in ent.get("components", []):
		comps.append(c.duplicate(true))
	var has := func(t: String) -> bool:
		for c in comps:
			if c["type"] == t:
				return true
		return false
	var has_mover := false
	for c in comps:
		if _comp_defs[c["type"]].get("mover", false):
			has_mover = true
	var added: Array = []
	match ent["role"]:
		"player":
			if not has_mover:
				var ctl: String = {"platformer_2d": "platformer_controller", "topdown_2d": "topdown_controller",
					"third_person_3d": "third_person_controller", "first_person_3d": "first_person_controller"}[genre]
				comps.append({"type": ctl})
				added.append(ctl)
			if not has.call("health"):
				comps.append({"type": "health", "max_health": 3})
				added.append("health")
			if genre != "first_person_3d" and not has.call("camera_follow"):
				comps.append({"type": "camera_follow"})
				added.append("camera_follow")
		"enemy":
			if not has.call("health"):
				comps.append({"type": "health", "max_health": 1, "score_value": 100})
				added.append("health")
			if not has.call("contact_damage") and not has.call("shooter"):
				var cd := {"type": "contact_damage"}
				if genre == "platformer_2d":
					cd["stomp"] = true
				comps.append(cd)
				added.append("contact_damage")
		"item":
			if not has.call("pickup"):
				comps.append({"type": "pickup"})
				added.append("pickup")
			if not has.call("spin_bob"):
				comps.append({"type": "spin_bob", "bob_height": 0.15 if is_3d else 3.0, "spin_degrees": 90.0 if is_3d else 0.0})
				added.append("spin_bob")
		"hazard":
			if not has.call("contact_damage"):
				comps.append({"type": "contact_damage"})
				added.append("contact_damage")
		"goal":
			if not has.call("door_trigger"):
				comps.append({"type": "door_trigger", "kind": "goal"})
				added.append("door_trigger")
	if not added.is_empty():
		report["notes"].append("entity '%s' (%s): added default components %s" % [key, ent["role"], ", ".join(added)])
	return comps


func _body_type(ent: Dictionary, comps: Array) -> String:
	var mover := false
	for c in comps:
		if _comp_defs[c["type"]].get("mover", false):
			mover = true
	var suffix := "3D" if is_3d else "2D"
	if ent["role"] == "block":
		return "StaticBody" + suffix
	if mover:
		return "CharacterBody" + suffix
	return "Node" + suffix


func _coerce(spec: Dictionary, v: Variant) -> Variant:
	match str(spec["type"]):
		"number":
			return float(v)
		"integer":
			return int(v)
		"color":
			return Color(str(v))
		"string_array":
			var arr: Array[String] = []
			for item in v:
				arr.append(str(item))
			return arr
		"object":
			return v
	return v


func _entity_scene(key: String) -> String:
	var ent: Dictionary = entities[key]
	var w := Tscn.new()
	var comps := effective_components(key)
	var body := _body_type(ent, comps)
	var role: String = ent["role"]
	var groups: Array = []
	if role != "block" and role != "prop" and role != "spawner":
		groups.append(role)
	for g in ent.get("groups", []):
		if not groups.has(g):
			groups.append(g)
	var props := {}
	if body.begins_with("CharacterBody"):
		props["collision_layer"] = 2 if role == "player" else 4
		props["collision_mask"] = 1
		if body == "CharacterBody3D":
			props["floor_snap_length"] = 0.4
	elif body.begins_with("StaticBody"):
		props["collision_layer"] = 1
		props["collision_mask"] = 0
	w.node(_pascal(key), body, "", props, groups)
	_add_visual(w, ent, role)
	if body != "Node2D" and body != "Node3D":
		_add_collision(w, ent)
	for c in comps:
		var spec: Dictionary = _comp_defs[c["type"]]
		var cprops := {"script": w.ext_ref("Script", spec["script"])}
		for pk in c.keys():
			if pk == "type":
				continue
			var pv: Variant = c[pk]
			if c["type"] == "spawner" and pk == "scene" and entities.has(pv):
				pv = "res://entities/%s.tscn" % pv
			cprops[pk] = _coerce(spec["params"][pk], pv)
		w.node(_pascal(c["type"]), "Node", ".", cprops)
	return w.serialize()


func _poly_points(shape: String, size: Array) -> PackedVector2Array:
	var hw: float = float(size[0]) / 2.0
	var hh: float = float(size[1]) / 2.0
	var pts := PackedVector2Array()
	match shape:
		"circle":
			var r := maxf(hw, hh)
			for i in range(16):
				pts.append(Vector2.from_angle(TAU * i / 16.0) * r)
		"capsule":
			var r2 := minf(hw, hh)
			var cy := hh - r2
			for i in range(0, 9):
				var a := PI + PI * i / 8.0
				pts.append(Vector2(cos(a) * r2, -cy + sin(a) * r2))
			for i in range(0, 9):
				var a2 := PI * i / 8.0
				pts.append(Vector2(cos(a2) * r2, cy + sin(a2) * r2))
		_:
			pts.append(Vector2(-hw, -hh))
			pts.append(Vector2(hw, -hh))
			pts.append(Vector2(hw, hh))
			pts.append(Vector2(-hw, hh))
	return pts


func _add_visual(w: Tscn, ent: Dictionary, role: String) -> void:
	var size := _size(ent)
	var color := _color(ent.get("color"), role)
	if not is_3d:
		if ent.has("sprite"):
			var sp: Dictionary = ent["sprite"]
			var sc := float(sp.get("scale", 1.0))
			var props := {"texture": w.ext_ref("Texture2D", sp["texture"]), "scale": Vector2(sc, sc)}
			if sp.has("hframes"):
				props["hframes"] = int(sp["hframes"])
			if sp.has("vframes"):
				props["vframes"] = int(sp["vframes"])
			if sp.has("frame"):
				props["frame"] = int(sp["frame"])
			w.node("Visual", "Sprite2D", ".", props)
			return
		w.node("Visual", "Polygon2D", ".", {"polygon": _poly_points(_shape(ent), size), "color": color})
		if role == "player" or role == "enemy" or role == "npc":
			var ex := float(size[0]) * 0.18
			var ey := -float(size[1]) * 0.18
			w.node("Eye", "Polygon2D", "Visual", {"polygon": PackedVector2Array([Vector2(ex - 2, ey - 2), Vector2(ex + 2, ey - 2), Vector2(ex + 2, ey + 2), Vector2(ex - 2, ey + 2)]), "color": Color(theme["text"])})
		return
	# 3D
	if ent.has("model") and FileAccess.file_exists(ent["model"]):
		var ms := float(ent.get("model_scale", 1.0))
		var off: Array = ent.get("model_offset", [0.0, -float(size[1]) / 2.0, 0.0])
		var props3 := {"position": Vector3(float(off[0]), float(off[1]), float(off[2]) if off.size() > 2 else 0.0),
			"scale": Vector3(ms, ms, ms), "rotation": Vector3(0.0, deg_to_rad(float(ent.get("model_rotation_y", 0.0))), 0.0)}
		w.instance("Visual", ent["model"], ".", props3)
		return
	var mesh: Variant
	var mat := w.sub("StandardMaterial3D", _material_props(color, ent.get("emissive", role == "item" or role == "goal")))
	match _shape(ent):
		"sphere":
			var r := float(size[0]) / 2.0
			mesh = w.sub("SphereMesh", {"radius": r, "height": r * 2.0, "material": mat})
		"capsule":
			mesh = w.sub("CapsuleMesh", {"radius": float(size[0]) / 2.0, "height": float(size[1]), "material": mat})
		_:
			mesh = w.sub("BoxMesh", {"size": Vector3(float(size[0]), float(size[1]), float(size[2])), "material": mat})
	w.node("Visual", "MeshInstance3D", ".", {"mesh": mesh})
	if role == "player" or role == "enemy" or role == "npc":
		var nose_mat := w.sub("StandardMaterial3D", _material_props(Color(theme["text"]), true))
		var nose := w.sub("BoxMesh", {"size": Vector3(0.22, 0.16, 0.3), "material": nose_mat})
		w.node("Nose", "MeshInstance3D", ".", {"mesh": nose, "position": Vector3(0.0, float(size[1]) * 0.25, -float(size[0]) * 0.5)})


func _material_props(color: Color, emissive: bool) -> Dictionary:
	var p := {"albedo_color": color, "roughness": 0.55}
	if emissive:
		p["emission_enabled"] = true
		p["emission"] = color
		p["emission_energy_multiplier"] = 0.7
	return p


func _add_collision(w: Tscn, ent: Dictionary) -> void:
	var size := _size(ent)
	var shape_name := _shape(ent)
	if not is_3d:
		var shape: Variant
		match shape_name:
			"circle":
				shape = w.sub("CircleShape2D", {"radius": maxf(float(size[0]), float(size[1])) / 2.0})
			"capsule":
				shape = w.sub("CapsuleShape2D", {"radius": float(size[0]) / 2.0, "height": float(size[1])})
			_:
				shape = w.sub("RectangleShape2D", {"size": Vector2(float(size[0]), float(size[1]))})
		w.node("Collision", "CollisionShape2D", ".", {"shape": shape})
		return
	var shape3: Variant
	match shape_name:
		"sphere":
			shape3 = w.sub("SphereShape3D", {"radius": float(size[0]) / 2.0})
		"capsule":
			shape3 = w.sub("CapsuleShape3D", {"radius": float(size[0]) / 2.0, "height": float(size[1])})
		_:
			shape3 = w.sub("BoxShape3D", {"size": Vector3(float(size[0]), float(size[1]), float(size[2]))})
	w.node("Collision", "CollisionShape3D", ".", {"shape": shape3})


# ------------------------------------------------------------------ levels

## One thing to place in a level.
class Placement:
	var key: String
	var pos: Vector3
	var rotation: float = 0.0
	var size: Array = []
	func _init(k: String, p: Vector3) -> void:
		key = k
		pos = p


func _role_of(key: String) -> String:
	return entities[key]["role"] if entities.has(key) else "block"


func _is_plain_block(key: String) -> bool:
	if key == "block" and not entities.has("block"):
		return true
	if not entities.has(key):
		return false
	var e: Dictionary = entities[key]
	return e["role"] == "block" and not e.has("sprite") and not e.has("model") and e.get("components", []).is_empty()


func _level_scene(level: Dictionary) -> String:
	var w := Tscn.new()
	var ts: float = float(level.get("tile_size", 2.0 if is_3d else 32.0))
	var legend: Dictionary = level.get("legend", {})
	var rows: Array = level.get("rows", [])
	var placements: Array = []
	var runs: Array = [] ## {key, row, col, len}
	var cols := 0
	for r in range(rows.size()):
		var row := String(rows[r])
		cols = maxi(cols, row.length())
		var c := 0
		while c < row.length():
			var ch := row[c]
			var key := ""
			if ch == "#" and not legend.has("#"):
				key = "block"
			elif legend.has(ch):
				key = legend[ch]
			if key == "":
				c += 1
				continue
			if _is_plain_block(key):
				var e := c
				while e < row.length() and ((row[e] == "#" and not legend.has("#") and key == "block") or (legend.has(row[e]) and legend[row[e]] == key)):
					e += 1
				runs.append({"key": key, "row": r, "col": c, "len": e - c})
				c = e
				continue
			placements.append(_grid_placement(key, r, c, ts))
			c += 1
	for o in level.get("objects", []):
		var count := int(o.get("count", 1))
		var step: Array = o.get("step", [ts, 0.0, 0.0])
		for i in range(count):
			var p: Array = o.get("pos", [0.0, 0.0, 0.0])
			var pos := Vector3(float(p[0]) + i * float(step[0]), float(p[1]) + i * float(step[1]), (float(p[2]) if p.size() > 2 else 0.0) + (i * float(step[2]) if step.size() > 2 else 0.0))
			if is_3d:
				# objects are positioned as [x, y, z] metres with y the floor height of the object's bottom
				pos = Vector3(float(p[0]) + i * float(step[0]), 0.0, (float(p[2]) if p.size() > 2 else float(p[1])) + i * (float(step[2]) if step.size() > 2 else float(step[1])))
				if p.size() > 2:
					pos.y = float(p[1])
			var pl := Placement.new(str(o["entity"]), pos)
			pl.rotation = float(o.get("rotation", 0.0))
			if o.has("size"):
				pl.size = o["size"]
			if _is_plain_block(pl.key):
				runs.append({"key": pl.key, "pos": pos, "size": o.get("size", [ts, ts] if not is_3d else [ts, ts * 1.5, ts]), "custom": true})
			else:
				if not (pl.key == "block"):
					pl.pos = _object_pos(pl.key, pos)
				placements.append(pl)

	# bounds
	var min_v := Vector2(INF, INF)
	var max_v := Vector2(-INF, -INF)
	if not rows.is_empty():
		min_v = Vector2.ZERO
		max_v = Vector2(cols * ts, rows.size() * ts)
	for pl in placements:
		min_v = Vector2(minf(min_v.x, pl.pos.x), minf(min_v.y, pl.pos.z if is_3d else pl.pos.y))
		max_v = Vector2(maxf(max_v.x, pl.pos.x), maxf(max_v.y, pl.pos.z if is_3d else pl.pos.y))
	for r in runs:
		if r.has("pos"):
			var rp: Vector3 = r["pos"]
			var rs: Array = r["size"]
			var half := Vector2(float(rs[0]), float(rs[2] if is_3d else rs[1])) / 2.0
			var cen := Vector2(rp.x, rp.z if is_3d else rp.y)
			min_v = Vector2(minf(min_v.x, cen.x - half.x), minf(min_v.y, cen.y - half.y))
			max_v = Vector2(maxf(max_v.x, cen.x + half.x), maxf(max_v.y, cen.y + half.y))
	if min_v.x == INF:
		min_v = Vector2.ZERO
		max_v = Vector2(20, 20) * ts

	var meta := {}
	var base_music: String = str(level.get("music", ""))
	if base_music != "":
		meta["music"] = recipe["audio"]["music"][base_music]
	if level.has("intro"):
		meta["intro"] = level["intro"]
	if is_3d:
		meta["kill_y"] = float(level.get("kill_y", -25.0))
	else:
		meta["kill_y"] = float(level.get("kill_y", max_v.y + 600.0))
		meta["bounds"] = [int(min_v.x), int(min_v.y), int(max_v.x), int(max_v.y)]
	var root_props := {"script": w.ext_ref("Script", "res://addons/amerika_engine/runtime/level.gd"), "level_name": level["name"], "meta": meta}
	w.node("Level", "Node3D" if is_3d else "Node2D", "", root_props)

	if is_3d:
		var env := w.sub("Environment", {
			"background_mode": 1, "background_color": Color(str(level.get("sky", theme["sky"]))),
			"ambient_light_source": 2, "ambient_light_color": Color(theme["text"]).lerp(Color(theme["sky"]), 0.6),
			"ambient_light_energy": 0.7, "tonemap_mode": 2, "glow_enabled": true,
		})
		w.node("WorldEnvironment", "WorldEnvironment", ".", {"environment": env})
		w.node("Sun", "DirectionalLight3D", ".", {"rotation": Vector3(deg_to_rad(-52.0), deg_to_rad(-35.0), 0.0), "light_energy": float(level.get("light", 1.0)), "shadow_enabled": true})
		if level.get("floor", true):
			_add_floor(w, min_v, max_v, ts)
	else:
		w.node("Background", "CanvasLayer", ".", {"layer": -100})
		w.node("Fill", "ColorRect", "Background", {"layout_mode": 3, "anchors_preset": 15, "anchor_right": 1.0, "anchor_bottom": 1.0, "grow_horizontal": 2, "grow_vertical": 2, "color": Color(str(level.get("background", theme["sky"]))), "mouse_filter": 2})

	# merged block runs
	var wall_h := float(level.get("wall_height", ts * 1.5))
	for i in range(runs.size()):
		_add_run(w, runs[i], i, ts, wall_h)

	# entity instances: scenery first, player last
	var order := {"prop": 0, "hazard": 1, "goal": 2, "npc": 3, "spawner": 4, "item": 5, "block": 6, "enemy": 7, "player": 8}
	var indexed: Array = []
	for i in range(placements.size()):
		indexed.append([order.get(_role_of(placements[i].key), 3), i])
	indexed.sort_custom(func(a: Array, b: Array) -> bool: return a[0] < b[0] or (a[0] == b[0] and a[1] < b[1]))
	var totals := {}
	for pl in placements:
		totals[pl.key] = int(totals.get(pl.key, 0)) + 1
	var seen := {}
	for ix in indexed:
		var pl: Placement = placements[ix[1]]
		seen[pl.key] = int(seen.get(pl.key, 0)) + 1
		var nm := _pascal(pl.key)
		if totals[pl.key] > 1:
			nm += "_%d" % seen[pl.key]
		var props := {}
		if is_3d:
			props["position"] = pl.pos
			if pl.rotation != 0.0:
				props["rotation"] = Vector3(0.0, deg_to_rad(pl.rotation), 0.0)
		else:
			props["position"] = Vector2(pl.pos.x, pl.pos.y)
			if pl.rotation != 0.0:
				props["rotation"] = deg_to_rad(pl.rotation)
		w.instance(nm, "res://entities/%s.tscn" % pl.key, ".", props)
	w.instance("HUD", "res://ui/hud.tscn", ".")
	return w.serialize()


func _grid_placement(key: String, r: int, c: int, ts: float) -> Placement:
	if is_3d:
		var size := _size(entities[key]) if entities.has(key) else [ts, ts, ts]
		var y := float(size[1]) / 2.0 + 0.02
		if _role_of(key) == "item":
			y = 0.9
		return Placement.new(key, Vector3((c + 0.5) * ts, y, (r + 0.5) * ts))
	var size2 := _size(entities[key]) if entities.has(key) else [ts, ts]
	var role := _role_of(key)
	var py := (r + 0.5) * ts
	if BOTTOM_ALIGNED.has(role):
		py = (r + 1) * ts - float(size2[1]) / 2.0
	return Placement.new(key, Vector3((c + 0.5) * ts, py, 0.0))


func _object_pos(key: String, pos: Vector3) -> Vector3:
	if is_3d and pos.y == 0.0 and entities.has(key):
		var size := _size(entities[key])
		pos.y = float(size[1]) / 2.0 + 0.02 if _role_of(key) != "item" else 0.9
	return pos


func _add_floor(w: Tscn, min_v: Vector2, max_v: Vector2, ts: float) -> void:
	var margin := ts * 4.0
	var size := Vector3(max_v.x - min_v.x + margin * 2.0, 1.0, max_v.y - min_v.y + margin * 2.0)
	var center := Vector3((min_v.x + max_v.x) / 2.0, -0.5, (min_v.y + max_v.y) / 2.0)
	var shader := w.sub("Shader", {"code": FLOOR_SHADER})
	var mat := w.sub("ShaderMaterial", {"shader": shader, "shader_parameter/base": Color(theme["ground"]), "shader_parameter/line": Color(theme["accent"]), "shader_parameter/cell": ts})
	var mesh := w.sub("BoxMesh", {"size": size, "material": mat})
	var shape := w.sub("BoxShape3D", {"size": size})
	w.node("Floor", "StaticBody3D", ".", {"position": center, "collision_layer": 1, "collision_mask": 0})
	w.node("Visual", "MeshInstance3D", "Floor", {"mesh": mesh})
	w.node("Collision", "CollisionShape3D", "Floor", {"shape": shape})


func _add_run(w: Tscn, run: Dictionary, index: int, ts: float, wall_h: float) -> void:
	var key: String = run["key"]
	var ent: Dictionary = entities.get(key, {"role": "block"})
	var color := _color(ent.get("color"), "block")
	var nm := "Blocks_%d" % index
	if not is_3d:
		var size := Vector2(float(run["len"]) * ts, ts)
		var center := Vector2((run["col"] + run["len"] / 2.0) * ts, (run["row"] + 0.5) * ts)
		if run.has("custom"):
			size = Vector2(float(run["size"][0]), float(run["size"][1]))
			center = Vector2(run["pos"].x, run["pos"].y)
		var hw := size.x / 2.0
		var hh := size.y / 2.0
		w.node(nm, "StaticBody2D", ".", {"position": center, "collision_layer": 1, "collision_mask": 0})
		w.node("Visual", "Polygon2D", nm, {"polygon": PackedVector2Array([Vector2(-hw, -hh), Vector2(hw, -hh), Vector2(hw, hh), Vector2(-hw, hh)]), "color": color})
		w.node("Top", "Polygon2D", nm, {"polygon": PackedVector2Array([Vector2(-hw, -hh), Vector2(hw, -hh), Vector2(hw, -hh + 3), Vector2(-hw, -hh + 3)]), "color": Color(theme["accent"]).lerp(color, 0.35)})
		w.node("Collision", "CollisionShape2D", nm, {"shape": w.sub("RectangleShape2D", {"size": size})})
		return
	var size3 := Vector3(float(run["len"]) * ts if run.has("len") else 0.0, wall_h, ts)
	var center3 := Vector3(0, wall_h / 2.0, 0)
	if run.has("custom"):
		var s: Array = run["size"]
		size3 = Vector3(float(s[0]), float(s[1]), float(s[2]) if s.size() > 2 else float(s[0]))
		center3 = Vector3(run["pos"].x, run["pos"].y + size3.y / 2.0, run["pos"].z)
	else:
		center3 = Vector3((run["col"] + run["len"] / 2.0) * ts, wall_h / 2.0, (run["row"] + 0.5) * ts)
	var mat := w.sub("StandardMaterial3D", _material_props(color, false))
	w.node(nm, "StaticBody3D", ".", {"position": center3, "collision_layer": 1, "collision_mask": 0})
	w.node("Visual", "MeshInstance3D", nm, {"mesh": w.sub("BoxMesh", {"size": size3, "material": mat})})
	w.node("Collision", "CollisionShape3D", nm, {"shape": w.sub("BoxShape3D", {"size": size3})})


# ------------------------------------------------------------------ simple scenes

func _hud_scene() -> String:
	var w := Tscn.new()
	w.node("HUD", "CanvasLayer", "", {"script": w.ext_ref("Script", "res://addons/amerika_engine/runtime/hud.gd")})
	return w.serialize()


func _simple_scene() -> String:
	var w := Tscn.new()
	var script := "res://addons/amerika_engine/runtime/vn_runner.gd" if genre == "visual_novel" else "res://addons/amerika_engine/runtime/memory_puzzle.gd"
	w.node("Main", "Control", "", {"script": w.ext_ref("Script", script), "layout_mode": 3, "anchors_preset": 15, "anchor_right": 1.0, "anchor_bottom": 1.0, "grow_horizontal": 2, "grow_vertical": 2})
	w.instance("HUD", "res://ui/hud.tscn", ".")
	return w.serialize()
